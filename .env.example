# Copy to .env. Defaults match `docker compose up` (see docker-compose.yml).
# Leave DATABASE_URL unset to use the embedded PGlite database in .pglite/ instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devtools

# Langfuse (local stack). Span-level traces for each run live here.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PROJECT_ID=devtools
LANGFUSE_PUBLIC_KEY=pk-lf-devtools-local
LANGFUSE_SECRET_KEY=sk-lf-devtools-local

# Session transcript (JSONL) storage: the 'transcripts' bucket in the stack's MinIO.
# Leave TRANSCRIPTS_S3_BUCKET unset to store transcripts on disk in .transcripts/ instead.
TRANSCRIPTS_S3_BUCKET=transcripts
TRANSCRIPTS_S3_ENDPOINT=http://localhost:9090
TRANSCRIPTS_S3_REGION=us-east-1
TRANSCRIPTS_S3_ACCESS_KEY_ID=minio
TRANSCRIPTS_S3_SECRET_ACCESS_KEY=miniosecret

# HTTP transport + preview
PORT=3333

# Full-text transcript search (ClickHouse). Leave CLICKHOUSE_URL unset to disable search.
# Local stack ClickHouse:
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=devtools
CLICKHOUSE_PASSWORD=devtools
# ClickHouse Cloud: point at the service and keep credentials in the gitignored
# clickhouse_credentials.txt ("Username: ..." / "Password: ..."); the file wins over CLICKHOUSE_USER/PASSWORD.
# CLICKHOUSE_URL=https://<service>.<region>.<provider>.clickhouse.cloud:8443
# CLICKHOUSE_CREDENTIALS_FILE=clickhouse_credentials.txt
