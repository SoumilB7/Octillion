# Real Postgres (docker compose up -d). Leave unset to use the embedded PGlite database in .pglite/
DATABASE_URL=postgres://devtools:devtools@localhost:5432/devtools

# Langfuse deep links for runs and sessions (span-level traces live in Langfuse)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=

# HTTP transport + preview
PORT=3333

# Optional boat.dev sandbox tools.
# Create a key from the Boat dashboard or `boat api-key create`; do not commit its value.
BOAT_MCP_ENABLED=false
BOAT_API_KEY=
BOAT_BASE_URL=https://boat.dev/api/v1

# Optional Python MCP upstream. Prefer a remote URL to offload work; use stdio for local development.
PYTHON_MCP_ENABLED=false
PYTHON_MCP_URL=
PYTHON_MCP_AUTH_TOKEN=
PYTHON_MCP_COMMAND=
PYTHON_MCP_ARGS=[]
PYTHON_MCP_ENV={}
